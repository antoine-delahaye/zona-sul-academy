{
  "name": "zona-sul-academy",
  "version": "1.0.0",
  "private": true,
  "description": "Site du club de jiu-jitsu brésilien et grappling Zona Sul Academy (Orléans)",
  "license": "MIT",
  "engines": {
    "node": "^24.15.0 || >=26.0.0",
    "npm": ">=11.0.0"
  },
  "volta": {
    "node": "24.21.0",
    "npm": "12.0.2"
  },
  "packageManager": "npm@12.0.2",
  "workspaces": [
    "blog",
    "cms"
  ],
  "scripts": {
    "prepare": "husky",
    "start": "npm run start -w blog",
    "start:blog": "npm run start -w blog",
    "start:cms": "npm run dev -w cms",
    "build": "npm run build --workspaces",
    "test": "npm run test -w blog",
    "lint": "npm run lint --workspaces",
    "lint:fix": "npm run lint -w blog -- --fix && npm run lint -w cms -- --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deploy:blog": "npm run deploy -w blog",
    "deploy:cms": "npm run deploy -w cms && npm run deploy:graphql -w cms"
  },
  "devDependencies": {
    "@angular/language-server": "^22.1.7",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.8",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11"
  },
  "overrides": {}
}
