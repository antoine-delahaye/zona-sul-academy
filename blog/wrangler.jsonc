{
  // Hosted schema on purpose: with npm workspaces, whether a package lands in
  // ./node_modules or ../node_modules depends on how npm hoists, so a relative
  // path here silently breaks on any reinstall.
  "$schema": "https://unpkg.com/wrangler@4/config-schema.json",
  "name": "zona-sul-academy",
  "main": "./dist/server/server.mjs",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/browser",
  },
  // Lets the contact endpoint in src/server.ts mail the club through Email
  // Routing, with no third-party provider and no API key. `destination_address`
  // pins the recipient, so the Worker can only ever write to that one address.
  //
  // It must be a *verified destination address* of the account (Email Routing →
  // Destination addresses), which is not the same thing as a custom address on
  // the zone: `contact@zonasulacademy.fr` is a routing rule that forwards to the
  // mailbox below, so sending to it fails with "destination address is not a
  // verified address". Mailing the mailbox directly lands in the same inbox.
  "send_email": [
    {
      "name": "SEND_EMAIL",
      "destination_address": "zonasulacademy@gmail.com",
    },
  ],
  "observability": {
    "enabled": true,
  },
  // Requires production source maps, enabled via `sourceMap` in angular.json.
  "upload_source_maps": true,
}
