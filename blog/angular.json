{
  "$schema": "https://unpkg.com/@angular/cli@22/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "schematicCollections": ["angular-eslint"]
  },
  "newProjectRoot": "projects",
  "projects": {
    "blog": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "server": "src/main.server.ts",
            "tsConfig": "tsconfig.app.json",
            "outputPath": "dist",
            "outputMode": "server",
            "ssr": {
              "entry": "src/server.ts",
              "platform": "neutral"
            },
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": ["src/styles.css"],
            "security": {
              "allowedHosts": [
                "zonasulacademy.fr",
                "www.zonasulacademy.fr",
                "zona-sul-academy.ztmyriam.workers.dev",
                "localhost",
                "127.0.0.1"
              ]
            }
          },
          "configurations": {
            "production": {
              "outputHashing": "all",
              "sourceMap": {
                "scripts": true,
                "styles": false
              },
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ]
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "blog:build:production"
            },
            "development": {
              "buildTarget": "blog:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "buildTarget": "blog:build:development",
            "tsConfig": "tsconfig.spec.json",
            "runner": "vitest",
            "coverageReporters": ["text-summary", "lcovonly"],
            "coverageExclude": ["src/main.ts", "src/main.server.ts", "src/server.ts"]
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": ["src/**/*.ts", "src/**/*.html", "*.mjs"]
          }
        }
      }
    }
  }
}
