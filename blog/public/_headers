# Applies to static asset responses only. Cloudflare does not apply this file to
# responses generated by Worker code, so the equivalent headers for SSR-rendered
# HTML live in src/server.ts. Keep the two in sync.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-transport-security: max-age=31536000; includeSubDomains; preload
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()

# Build output is content-hashed, so it can be cached indefinitely.
/*.js
  Cache-Control: public, max-age=31536000, immutable

/*.css
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable
